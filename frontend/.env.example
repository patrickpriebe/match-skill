# Spring REST API base URL. /api uses the development proxy.
VITE_API_BASE_URL=/api
# Optional development proxy override (never a production API key).
VITE_API_PROXY_TARGET=http://localhost:8080
# Production always uses real HTTP. Browser fixtures belong to tests only.
# Vercel: set VITE_API_BASE_URL in project settings to the actual Render HTTPS
# origin plus /api. The hosted build rejects this file's relative local default.
# VITE_* values are public in the bundle: never put credentials here.
# Spring CORS must allow the exact frontend origin; OAuth returns to /auth/callback.
